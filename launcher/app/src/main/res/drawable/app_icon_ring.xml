<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-10-25 K：图标优先磁贴的焦点框。双层：外层细白圈 + 内层 2dp 白框和一点白色雾面，
     只包住 72dp 应用图标，不再套住整张卡片。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#5CFFFFFF" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="21dp" />
            <stroke android:width="2dp" android:color="#F2FFFFFF" />
        </shape>
    </item>
</layer-list>
